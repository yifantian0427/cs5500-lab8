{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "location", "isAvailable"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["ROOM", "EQUIPMENT", "LAB"]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "isAvailable": {
      "type": "boolean"
    }
  }
}
