{
  "name": "campushub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "seed": "npm run build && node --env-file-if-exists=.env dist/seed.js",
    "test:legacy": "npm run build && node --env-file-if-exists=.env --test dist/tests/*.test.js",
    "test:coverage": "npm test -- --coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "@types/jest": "^29.5.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^10.2.0"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.1"
  }
}
